# ═══════════════════════════════════════════════════════════
#  RESE+ — .gitignore
#  Arquivos que NAO devem ir pro GitHub
# ═══════════════════════════════════════════════════════════

# Variaveis de ambiente (CRITICO — contem SECRET_KEY!)
.env
.env.local
.env.production
*.env

# Banco de dados SQLite
*.sqlite3
*.sqlite3-journal
db.sqlite3
db.sqlite3-journal

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual env
venv/
env/
ENV/
.venv/
.env/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Sistema
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Arquivos de teste
.pytest_cache/
.coverage
htmlcov/
.tox/

# Migracoes (opcional — alguns times versionam, outros nao)
# Se quiser versionar, comente essas linhas:
# dispositivos/migrations/*
# !dispositivos/migrations/__init__.py

# Media files (uploads de usuarios)
media/
uploads/

# Static files coletados
staticfiles/
static_collected/

# Arquivos temporarios
*.tmp
*.bak
*.backup
*.orig
